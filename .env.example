# Copy to .env and fill in. .env is git-ignored.

# Model (one-line switch). Default: anthropic:claude-sonnet-5-5
# DOME_MODEL=openai:gpt-5.5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LangSmith tracing (every supervisor step and tool call shows up as a trace)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dome
