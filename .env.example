# Copy to .env and fill in. .env is git-ignored and never pushed.

# ---- Model (one-line switch) ----
# Free: Google Gemini free tier. Key from https://aistudio.google.com/apikey
DOME_MODEL=google_genai:gemini-3.5-flash
GOOGLE_API_KEY=

# Paid alternatives (comment out the two lines above and use one of these):
# DOME_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# DOME_MODEL=openai:gpt-5.5
# OPENAI_API_KEY=

# ---- LangSmith tracing (free plan): every supervisor step and tool call as a trace ----
# Key from https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dome

# ---- Night flags (each off unless set to 1; turned on at the merge only if it works) ----
# DOME_MONEY=1        money.attach(case): wallet clusters + wallet_notes.json (Ishaan)
# DOME_SPOTTER=1      spotter.run(case): case/<id>/spotter.json (Ishaan)
# DOME_LINK_MONEY=1   Linker second pass with wallet notes as `money` keys (Avishek)
# DOME_GRAPH=1        UI streams runs through dome/graph_stream.py (LangGraph; Yug's UI)
# DOME_GRAPH_URL=http://127.0.0.1:2024   `langgraph dev`; "inproc" runs the rules graph in-process
# DOME_GRAPH_ASSISTANT=dome_rules        or "dome" for the LLM supervisor
