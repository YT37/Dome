<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dome case {{ b.case_id }}</title>
<style>
  :root { --bg:#f7f7f5; --card:#fff; --ink:#1d1d1b; --muted:#6b6b66; --line:#e2e1dc;
          --high:#b42318; --medium:#b54708; --low:#475467; --banner:#1d2939; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#141413; --card:#1f1f1d; --ink:#ecebe6; --muted:#a3a29b; --line:#33332f;
            --high:#f97066; --medium:#fdb022; --low:#98a2b3; --banner:#0c111d; } }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:15px/1.5 system-ui, sans-serif; }
  .banner { background:var(--banner); color:#fff; padding:8px 16px; font-size:13px; letter-spacing:.02em; }
  main { max-width:1040px; margin:0 auto; padding:24px 16px 48px; }
  h1 { font-size:24px; margin:0 0 4px; } h2 { font-size:17px; margin:28px 0 10px; }
  .meta { color:var(--muted); margin:0 0 16px; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:12px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
  .card h3 { margin:0 0 6px; font-size:15px; } .card ul { margin:6px 0 0; padding-left:18px; }
  .muted { color:var(--muted); } .small { font-size:13px; }
  .table-wrap { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:10px; }
  th, td { text-align:left; vertical-align:top; padding:10px 12px; border-bottom:1px solid var(--line); }
  th { font-size:13px; color:var(--muted); font-weight:600; }
  td ul { margin:0; padding-left:18px; }
  .tier { font-weight:700; } .tier.High { color:var(--high); } .tier.Medium { color:var(--medium); } .tier.Low { color:var(--low); }
  .cap { color:var(--medium); }
  .status { font-weight:600; }
  footer { margin-top:32px; padding-top:12px; border-top:1px solid var(--line); color:var(--muted); font-size:13px; }
  a { color:inherit; }
</style>
</head>
<body>
<div class="banner">Synthetic data · leads for human verification only{% if ring and ring.public_only %} · Public data only{% endif %}</div>
<main>
  <h1>Dome case {{ b.case_id }}</h1>
  <p class="meta">Ring {{ b.ring_id or "none" }}{% if ring %} ({{ ring.line }}){% endif %}
    · status: <span class="status">{{ b.status }}</span>
    · zones: {{ b.zones | join(", ") or "none" }}</p>
  {% if b.summary %}<p>{{ b.summary }}</p>{% endif %}
  {% if b.failed_steps %}
  <p class="cap">Failed or missing steps: {{ b.failed_steps | join(", ") }}. Every lead is capped at Low.</p>
  {% endif %}

  <div class="cards">
    <section class="card">
      <h3>Ring</h3>
      {% if ring %}
      <div>{{ ring.line }}</div>
      <div class="small muted">Key kinds: {{ ring.key_kinds | join(", ") }}{% if ring.photos %} · {{ ring.photos }} ring photos{% endif %}</div>
      {% if ring.links %}<ul class="small">{% for l in ring.links %}<li>{{ l }}</li>{% endfor %}</ul>{% endif %}
      <h3 style="margin-top:10px">Likely recruiters</h3>
      {% if ring.recruiters %}<ul class="small">{% for r in ring.recruiters %}<li>{{ r.account }}: {{ r.reason }}</li>{% endfor %}</ul>
      {% else %}<div class="small muted">none found</div>{% endif %}
      {% else %}
      <div class="muted">No ring found.</div>
      {% endif %}
    </section>
    {% for z in zones %}
    <section class="card">
      <h3>Zone {{ z.zone_id }}{% if z.wide %} <span class="small muted">(wide)</span>{% endif %}</h3>
      <div>{{ z.area_km2 }} km² · {{ "%.0f" | format(z.weight_share * 100) }}% of place-clue weight · confidence {{ "%.2f" | format(z.confidence) }}</div>
      <ul class="small">{% for r in z.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
    </section>
    {% endfor %}
  </div>

  <h2>Ranked buildings</h2>
  <div class="table-wrap">
  <table>
    <tr><th>#</th><th>Building</th><th>Tier</th><th>Score</th><th>Why</th><th>Verify next</th></tr>
    {% for l in b.leads %}
    <tr>
      <td>{{ l.rank }}</td>
      <td>{{ l.display_name }}<div class="small muted">{{ l.zone_id }}</div></td>
      <td class="tier {{ l.tier }}">{{ l.tier }}</td>
      <td>{{ l.score }}</td>
      <td><ul class="small">{% for r in l.reasons %}<li>{{ r }}</li>{% endfor %}
        {% for c in l.caps %}<li class="cap">{{ c }}</li>{% endfor %}</ul></td>
      <td><ul class="small">{% for v in l.verify_next %}<li>{{ v }}</li>{% endfor %}</ul></td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="muted">No building leads{% if b.status == "weak_ring_zone_only" %}: weak ring, the zone is the only output{% endif %}.</td></tr>
    {% endfor %}
  </table>
  </div>
  {% if not_leads %}
  <ul class="small muted">{% for line in not_leads %}<li>{{ line }}</li>{% endfor %}
    <li>A building needs a photo match to become a lead. Place clues alone never do.</li></ul>
  {% endif %}

  <h2>Supervisor decisions</h2>
  <ul class="small">{% for d in b.decisions %}<li>{{ d }}</li>{% else %}<li class="muted">none</li>{% endfor %}</ul>
  <p class="small muted">Tiers and scores are computed by code; wording by {{ wording }}.
    Full trail: <a href="log.jsonl">log.jsonl</a></p>

  <footer>{{ b.footer }}</footer>
</main>
</body>
</html>
